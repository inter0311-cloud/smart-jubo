# Cloudflare Pages / Netlify: revalidate app entry points on every request.
/index.html
  Cache-Control: no-store, max-age=0
/
  Cache-Control: no-store, max-age=0
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/recovery.html
  Cache-Control: no-store, max-age=0
/recovery
  Cache-Control: no-store, max-age=0
/manifest.json
  Cache-Control: no-cache, max-age=0
